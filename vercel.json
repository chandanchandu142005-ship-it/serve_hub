{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/servehub",
      "destination": "/servehub.html"
    },
    {
      "source": "/servehub/",
      "destination": "/servehub.html"
    },
    {
      "source": "/((?!api/|.*\\.).*)",
      "destination": "/servehub.html"
    }
  ]
}
