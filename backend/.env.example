# Database connection string (MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/servehub
MONGODB_URI=mongodb://127.0.0.1:27017/servehub

# JWT Secret key for signing auth tokens
JWT_SECRET=servehub_super_secret_jwt_key_2026

# Email configuration (Nodemailer - Gmail / Custom SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=ServeHub <no-reply@servehub.in>

# Frontend client URL
CLIENT_URL=http://localhost:5173

# Server port
PORT=4000
